# Care-Shield Environment Configuration
# SerpApi API Key (Required for live Google Shopping, Google Lens, Google Search, Google Maps)
SERPAPI_KEY=your_serpapi_key_here
SERPAPI_API_KEY=your_serpapi_key_here

# Google Gemini API Key (Required for live Vision OCR ingestion)
GEMINI_API_KEY=your_gemini_api_key_here

# Offline demo playback mode (set to true to run fully without external API calls)
USE_FIXTURES=false
